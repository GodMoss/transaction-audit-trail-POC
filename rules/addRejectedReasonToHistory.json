      "unionWithCurrentValue": false,
      "clearValue": false,
      "scriptContent": "var old = txn.custom.approvalHistory;\n\nvar stages = {\n  \"draft\": \"Draft\",\n  \"pendingApproval\": \"Pending Approval\",\n  \"rejected\": \"Rejected\",\n  \"approved\": \"Approved\",\n  \"sentToCustomer\": \"Sent to Customer\",\n  \"ordered\": \"Ordered\"\n};\n\nvar timestamp = Date.now().toISOString();\nvar dateString = timestamp;\nvar year = dateString.substring(0, 4);\nvar month = dateString.substring(5, 7);\nvar day = dateString.substring(8, 10);\nvar formattedDate = month + \"/\" + day + \"/\" + year;\n\nvar rreason = \"\\n\" + formattedDate + \" Transitioned to \" + stages.get(txn.stage) + \" by \" + txn.modifiedBy +  \" - Reason for rejection: \" + txn.custom.rejectedReason;\n// var rreason = \"\\n\" + formattedDate + \" Reason for rejection: \" + txn.custom.rejectedReason;\n\nreturn rreason + old;\n\n/*\n\n\n{\n\t\"txn\":{\n    \"stage\": \"draft\",\n    \"custom.approvalHistory\": \"This is the old\"\n  }\n}\n\n*/"
    }
